# BizBot 环境变量配置

# MySQL 端口（内部使用，保留给宝塔参数兼容）
MYSQL_PORT=3306

# BizBot 端口
GATEWAY_PORT=8085
MAIN_PORT=8089

# Nginx 统一入口端口
NGINX_PORT=8090

# Chrome 代理地址
# 不使用代理时留空：
CHROME_PROXY=

# 示例：
# CHROME_PROXY=http://192.168.31.237:16699
# CHROME_PROXY=socks5://192.168.31.237:1080

# RDP 远程桌面密码
# 注意：如果底层 VNC/RDP 网关只支持 8 位密码，超过 8 位可能只识别前 8 位。
RDP_PASSWORD=VisBot

# PersonBot 后台 API Key，交付客户前建议改成客户专用值
PERSONBOT_API_KEY=CHANGE_ME_LOCAL_API_KEY_8020

# 远程桌面分辨率
SCREEN_WIDTH=1440
SCREEN_HEIGHT=900
SCREEN_DEPTH=24

# 宿主机端口
VISBOT_RDP_HOST_PORT=3391
VISBOT_PERSONBOT_HOST_PORT=5173

# VisBot 容器内 PersonBot 实际监听端口
# 当前镜像内实际服务是 18020，通常不要改这个值。
VISBOT_PERSONBOT_CONTAINER_PORT=18020

# VisBot Web 服务端口
VISBOT_WEB_HOST_PORT=8030

# 必填通用项
HOST_IP=0.0.0.0
CPUS=0
MEMORY_LIMIT=0
APP_PATH=/mnt/bizbot
VISBOT_APP_PATH=/mnt/visbotubuntu

# JVM 内存配置
JVM_MEMORY=1024
